# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.
# Credentials: prefer env vars (REDISCLOUD_ACCESS_KEY / REDISCLOUD_SECRET_KEY).

credit_card_type      = "Visa"
credit_card_last_four = "1234"

subscription_name          = "cmk-lab-mvp"
aws_region                 = "sa-east-1"
networking_deployment_cidr = "10.42.0.0/24"
cloud_account_id           = "1"

